<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Ahjo.Miniaudio</RootNamespace>
    <AssemblyName>Ahjo.Miniaudio</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Ship the XML docs in the package: the API's contracts (threading,
         allocation, lifetime) live in them. Every public member must carry
         one; CS1591 is an error under TreatWarningsAsErrors. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Published as "Ahjo.Miniaudio" on NuGet: the idiomatic, low-allocation
    wrapper over Ahjo.Miniaudio.Native for the Ahjo game engine.

    publish.yml packs it right after the Native package. The ProjectReference
    below becomes a NuGet dependency on Ahjo.Miniaudio.Native at the same
    MinVer version, so the two always ship as a matched pair.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Ahjo.Miniaudio</PackageId>
    <Title>Ahjo.Miniaudio</Title>
    <Description>Idiomatic, low-allocation .NET wrapper for miniaudio, built for the Ahjo game engine. Native AOT compatible.</Description>
    <PackageTags>audio;miniaudio;sound;playback;gamedev;game-engine;ahjo</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ahjo.Miniaudio.Native\Ahjo.Miniaudio.Native.csproj" />
  </ItemGroup>

</Project>
