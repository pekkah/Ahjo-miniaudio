!.claude/settings.json

# ---------------------------------------------------------------------------
# Project-specific
# ---------------------------------------------------------------------------

# Fetched miniaudio release archive — refetched by the Regenerate target.
# native/miniaudio/include/miniaudio.h is the generator input of record and is
# committed, so a normal build never touches the network.
native/miniaudio/downloaded/

# cmake scratch tree for the ahjo_miniaudio shared library, per RID.
native/miniaudio/build/

# Per-RID ahjo_miniaudio binaries: built locally by BuildMiniaudioForHost,
# downloaded from the CI matrix before pack. Never committed — the
# "!native/**/lib/**" un-ignore rules above exist for VENDORED binaries, and
# these are built, which is also why this directory is not called lib.
native/miniaudio/staged/
