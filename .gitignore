# Compiled (native) libraries — not ignored under runtimes/ where vendored
# native binaries are often committed for cross-platform shipping.
*.dll
*.so
*.so.*
*.dylib
*.exe
!runtimes/**/*.dll
!runtimes/**/*.so
!runtimes/**/*.so.*
!runtimes/**/*.dylib
!native/**/lib/**/*.dll
!native/**/lib/**/*.so
!native/**/lib/**/*.so.*
!native/**/lib/**/*.dylib
!third_party/**/lib/**/*.dll
!third_party/**/lib/**/*.so
!third_party/**/lib/**/*.so.*
!third_party/**/lib/**/*.dylib

